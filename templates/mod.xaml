<local:MyCard Grid.Row="{row}" Grid.Column="{column}" Margin="5" UseAnimation="False" VerticalAlignment="Top">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <local:MyImage Grid.Row="0" Source="{img}" Stretch="Uniform" Height="110" />
        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"
                       Foreground="{DynamicResource ColorBrush1}" Text="{name}" VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            {stats}
            {tags}
            {desc}
            {buttons}
        </StackPanel>
    </Grid>
</local:MyCard>
