<local:MyCard Grid.Row="{row}" Grid.Column="{column}" Margin="5" UseAnimation="False">
    <StackPanel Margin="10" VerticalAlignment="Center">
        <local:MyImage Source="{img}" Stretch="Uniform" Height="110" />
        <StackPanel Margin="0,10,0,0">
            <TextBlock FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"
                       Foreground="{DynamicResource ColorBrush1}" Text="{name}" VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            {stats}
            {tags}
            {desc}
            {buttons}
        </StackPanel>
    </StackPanel>
</local:MyCard>
